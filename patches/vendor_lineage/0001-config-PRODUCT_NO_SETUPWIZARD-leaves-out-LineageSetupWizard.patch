---
 config/common.mk | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/config/common.mk b/config/common.mk
index d1a2dbb..749c6eb 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -149,9 +149,13 @@ endif
 
 ifeq ($(PRODUCT_IS_AUTOMOTIVE),)
 PRODUCT_PACKAGES += \
-    LineageParts \
+    LineageParts
+# A container (etesian-redroid) starts provisioned and has no setup wizard.
+ifneq ($(PRODUCT_NO_SETUPWIZARD),true)
+PRODUCT_PACKAGES += \
     LineageSetupWizard
 endif
+endif
 
 PRODUCT_PACKAGES += \
     LineageSettingsProvider \
